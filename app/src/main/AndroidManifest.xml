<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickBar"
        tools:targetApi="33">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Long-pressing a quick settings tile normally opens App Info. HyperOS and MIUI
                both honour this filter, which turns the long press into "bind a shortcut here".
            -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!--
            Launched by the quick settings tile, which runs as the SystemUI uid, so this
            activity has to be exported. It only renders the local shortcut list and forwards
            the tap on to the user's own file, so nothing is passed in through the Intent.
        -->
        <activity
            android:name=".panel.QuickBarPanelActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.QuickBar.Panel" />

        <!--
            Trampoline for direct tile taps. Exported for the same reason as the panel above,
            and it accepts only a shortcut id that is looked up in this app's own storage.
        -->
        <activity
            android:name=".panel.ShortcutLaunchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.QuickBar.Panel" />

        <!--
            Panel tile: one tap expands the full shortcut grid.

            The QS_TILE intent filter is mandatory, not decorative: MIUI/HyperOS SystemUI
            discovers third-party tiles by querying that action, so a service declared with
            only the BIND_QUICK_SETTINGS_TILE permission can stay invisible there.

            META_DATA_ACTIVE_TILE keeps added tiles bound. Android 13+ otherwise allows only
            three concurrent bindings for third-party tiles, and with seven published tiles
            the rest would cold-start on every tap.
        -->
        <service
            android:name=".tiles.QuickBarTileService"
            android:description="@string/tile_panel_desc"
            android:exported="true"
            android:icon="@drawable/ic_tile_quickbar"
            android:label="@string/tile_panel_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Direct tiles: one tap opens a single bound shortcut. -->
        <service
            android:name=".tiles.DirectTileService1"
            android:exported="true"
            android:icon="@drawable/ic_tile_photo"
            android:label="@string/tile_slot_1_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tiles.DirectTileService2"
            android:exported="true"
            android:icon="@drawable/ic_tile_video"
            android:label="@string/tile_slot_2_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tiles.DirectTileService3"
            android:exported="true"
            android:icon="@drawable/ic_tile_folder"
            android:label="@string/tile_slot_3_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tiles.DirectTileService4"
            android:exported="true"
            android:icon="@drawable/ic_tile_star"
            android:label="@string/tile_slot_4_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tiles.DirectTileService5"
            android:exported="true"
            android:icon="@drawable/ic_tile_link"
            android:label="@string/tile_slot_5_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tiles.DirectTileService6"
            android:exported="true"
            android:icon="@drawable/ic_tile_camera"
            android:label="@string/tile_slot_6_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
    </application>

</manifest>
